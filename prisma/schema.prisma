// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/core/database/prisma/generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  phone         String   @unique
  address       String
  registered_at DateTime @default(now())
  is_active     Boolean  @default(true)

  pets                Pet[] // um cliente recebe varios pets
  customerPackageSubs CustomerPackageSubscription[]
  serviceAppointments ServiceAppointment[]

  @@map("customers")
}

// PORTE DO PET
enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

model Pet {
  id            String   @id @default(uuid())
  customer_id   String
  name          String
  breed         String
  size          PetSize
  notes         String
  is_active     Boolean  @default(true)
  customer      Customer @relation(fields: [customer_id], references: [id]) // referenciando o cliente
  registered_at DateTime @default(now())

  serviceAppoiments ServiceAppointment[]

  @@map("pets")
}

enum UserRole {
  SUPER
  ADMIN
  EMPLOYEE
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          UserRole
  is_active     Boolean  @default(true)

  serviceAppointments ServiceAppointment[]

  @@map("users")
}

model Service {
  id          String  @id @default(uuid())
  name        String
  description String
  is_active   Boolean @default(true)

  servicePrices                 ServicePrice[]
  packageServices               PackageService[]
  serviceAppointments           ServiceAppointment[]
  customerPackageServiceCredits CustomerPackageServiceCredit[]

  @@map("services")
}

model ServicePrice {
  id         String  @id @default(uuid())
  service_id String
  pet_size   PetSize // chamando do enum sizePet acima
  base_price Int
  is_active  Boolean @default(true)
  service    Service @relation(fields: [service_id], references: [id])

  @@map("service_prices")
}

model Package {
  id            String  @id @default(uuid())
  name          String
  description   String
  total_price   Int
  duration_days Int
  is_active     Boolean @default(true)

  packageServices              PackageService[]
  customerPackageSubscriptions CustomerPackageSubscription[]

  @@map("packages")
}

model PackageService {
  id                String  @id @default(uuid())
  package_id        String
  service_id        String
  included_quantity Int
  package           Package @relation(fields: [package_id], references: [id])
  service           Service @relation(fields: [service_id], references: [id])

  @@map("packag_services")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  ENDED
}

model CustomerPackageSubscription {
  id                      String             @id @default(uuid())
  customer_id             String
  package_id              String
  contracted_price        Int
  auto_renew              Boolean            @default(true)
  subscription_started_at DateTime           @default(now())
  last_renewed_at         DateTime
  renewal_day             Int
  status                  SubscriptionStatus // usando o enum statusPackageSubscription acima

  customer Customer @relation(fields: [customer_id], references: [id])
  package  Package  @relation(fields: [package_id], references: [id])

  customerPackageCycles CustomerPackageCycle[]

  @@map("customer_package_subscriptions")
}

enum CycleStatus {
  ACTIVE
  EXPIRED
  CANCELED
  FINISHED
}

model CustomerPackageCycle {
  id              String                      @id @default(uuid())
  subscription_id String
  cycle_number    Int
  starts_at       DateTime
  ends_at         DateTime
  renewed_at      DateTime                    @default(now())
  cycle_price     Int
  status          CycleStatus
  subscription    CustomerPackageSubscription @relation(fields: [subscription_id], references: [id])

  customerPackageServiceCredits CustomerPackageServiceCredit[]
  appointments                  ServiceAppointment[]

  @@map("customer_package_cycles")
}

model CustomerPackageServiceCredit {
  id                 String               @id @default(uuid())
  cycle_id           String
  service_id         String
  total_quantity     Int
  used_quantity      Int
  available_quantity Int
  cycle              CustomerPackageCycle @relation(fields: [cycle_id], references: [id])
  service            Service              @relation(fields: [service_id], references: [id])

  customerPackageCreditUsages CustomerPackageCreditUsage[]

  @@map("customer_package_service_credits")
}

enum BillingOrigin {
  ONE_TIME
  PACKAGE_CREDIT
  SUBSCRIPTION
}

enum PriceAdjustmentType {
  NONE
  DISCOUNT
  SURCHARGE
}

enum AppointmentStatus {
  COMPLETED
  CANCELED
}

model ServiceAppointment {
  id                      String              @id @default(uuid())
  customer_id             String
  pet_id                  String
  service_id              String
  user_id                 String
  cycle_id                String?
  billing_origin          BillingOrigin
  base_price              Int
  price_adjustment_type   PriceAdjustmentType
  price_adjustment_amount Int
  final_price             Int
  price_adjustment_reason String
  status                  AppointmentStatus
  performed_at            DateTime            @default(now())
  notes                   String

  // referencia opcional
  customerPackageCycle CustomerPackageCycle? @relation(fields: [cycle_id], references: [id])

  // relações obrigatorias
  customer Customer @relation(fields: [customer_id], references: [id])
  pet      Pet      @relation(fields: [pet_id], references: [id])
  service  Service  @relation(fields: [service_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])

  creditUsage CustomerPackageCreditUsage?

  @@map("service_appointments")
}

model CustomerPackageCreditUsage {
  id                String   @id @default(uuid())
  service_credit_id String
  appointment_id    String   @unique
  used_quantity     Int
  used_at           DateTime @default(now())

  serviceCredit      CustomerPackageServiceCredit @relation(fields: [service_credit_id], references: [id])
  serviceAppointment ServiceAppointment           @relation(fields: [appointment_id], references: [id])

  @@map("customer_package_credit_usages")
}
